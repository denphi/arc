# ── Provider (pick one) ────────────────────────────────────────────────────

# Option A: Anthropic (commercial)
# ARC_PROVIDER=anthropic
# ARC_MODEL=claude-opus-4-7
# ANTHROPIC_API_KEY=your-key-here

# Option B: OpenAI (commercial)
# ARC_PROVIDER=openai
# ARC_MODEL=gpt-4.1
# OPENAI_API_KEY=your-key-here

# Option C: OpenWebUI / Purdue GenAI (open-weight models via gateway)
ARC_PROVIDER=openwebui
OPENWEBUI_URL=https://genai.rcac.purdue.edu/api
OPENWEBUI_KEY=your-bearer-token-here
OPENWEBUI_MODEL=llama3.3:70b
# Leave OPENWEBUI_MODEL blank to auto-select the first available model.

# ── Storage ────────────────────────────────────────────────────────────────
ARC_ARTIFACT_ROOT=workspace/artifacts
ARC_RESULTS_ROOT=workspace/runs
ARC_RUNTIME_ADAPTER=auto

# ── External coding backends ───────────────────────────────────────────────
# Used by chat commands:
#   /coder codex
#   /coder claude
#
# If the command is not on PATH, use the absolute executable path.
ARC_CODEX_COMMAND=codex
ARC_CODEX_GLOBAL_ARGS=
ARC_CODEX_ARGS=exec
ARC_CODEX_MODEL=
ARC_CODEX_PROFILE=
ARC_CODEX_SANDBOX=workspace-write
ARC_CODEX_APPROVAL_POLICY=never
ARC_CODEX_INTERACTIVE_APPROVAL_POLICY=on-request
ARC_CODEX_ALLOW_NON_INTERACTIVE=false
ARC_CODEX_SKIP_GIT_REPO_CHECK=true
ARC_CODEX_CONFIG=
ARC_CODEX_EXTRA_ARGS=
ARC_CODEX_TIMEOUT_SECONDS=300

ARC_CLAUDE_CODE_COMMAND=claude
ARC_CLAUDE_CODE_ARGS=-p
ARC_CLAUDE_CODE_MODEL=sonnet
ARC_CLAUDE_CODE_FALLBACK_MODEL=
ARC_CLAUDE_CODE_PERMISSION_MODE=bypassPermissions
ARC_CLAUDE_CODE_OUTPUT_FORMAT=text
ARC_CLAUDE_CODE_MAX_BUDGET_USD=
ARC_CLAUDE_CODE_EFFORT=
ARC_CLAUDE_CODE_ALLOWED_TOOLS=
ARC_CLAUDE_CODE_DISALLOWED_TOOLS=
ARC_CLAUDE_CODE_SYSTEM_PROMPT=
ARC_CLAUDE_CODE_APPEND_SYSTEM_PROMPT=
ARC_CLAUDE_CODE_EXTRA_ARGS=
ARC_CLAUDE_CODE_TIMEOUT_SECONDS=300
